<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MediaForge.Universal.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:coreModels="clr-namespace:MediaForge.GenZ.Core.Models;assembly=MediaForge.GenZ.Core"
    xmlns:viewModels="clr-namespace:MediaForge.Universal.ViewModels"
    x:DataType="viewModels:HomeViewModel"
    BackgroundColor="{StaticResource Canvas}">
    <Grid Padding="24,28,24,24" RowDefinitions="Auto,*,Auto" RowSpacing="20">
        <Grid ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Spacing="10">
                <Border
                    Padding="10,6"
                    BackgroundColor="{StaticResource PrimarySoft}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12">
                    <Label FontAttributes="Bold" FontSize="13" Text="MF" TextColor="{StaticResource Primary}" />
                </Border>
                <Label
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    FontSize="17"
                    Text="{Binding ProductName}"
                    TextColor="{StaticResource Ink}" />
            </HorizontalStackLayout>
            <ActivityIndicator
                Grid.Column="1"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Primary}" />
        </Grid>

        <ScrollView Grid.Row="1" IsVisible="{Binding ShowWelcome}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="22">
                <Border
                    Padding="12,7"
                    HorizontalOptions="Start"
                    BackgroundColor="{StaticResource MintSoft}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                    <Label FontAttributes="Bold" FontSize="12" Text="OFFLINE BY DEFAULT" TextColor="{StaticResource MintDark}" />
                </Border>
                <Label
                    FontAttributes="Bold"
                    FontSize="42"
                    LineHeight="1.05"
                    Text="{Binding Headline}"
                    TextColor="{StaticResource Ink}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label FontSize="16" LineHeight="1.45" Text="{Binding Description}" TextColor="{StaticResource InkMuted}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource FeatureCard}">
                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" Text="Fast &amp; simple" TextColor="{StaticResource Ink}" />
                            <Label FontSize="12" Text="Pick multiple media files" TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FeatureCard}">
                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" Text="Private" TextColor="{StaticResource Ink}" />
                            <Label FontSize="12" Text="Files stay on device" TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Label
                    IsVisible="{Binding IsStatusVisible}"
                    FontSize="13"
                    Text="{Binding StatusMessage}"
                    TextColor="{StaticResource InkMuted}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            Grid.Row="1"
            IsVisible="{Binding HasMedia}"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label FontAttributes="Bold" FontSize="28" Text="Media library" TextColor="{StaticResource Ink}" />
                    <Label FontSize="13" Text="{Binding ImportedCountLabel}" TextColor="{StaticResource InkMuted}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Command="{Binding ClearAllCommand}" Style="{StaticResource TextButton}" Text="Clear all" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Label
                    VerticalOptions="Center"
                    FontSize="12"
                    Text="Tap a card for details"
                    TextColor="{StaticResource InkMuted}" />
                <Button
                    Grid.Column="1"
                    Command="{Binding ClearSelectedCommand}"
                    IsVisible="{Binding HasSelection}"
                    Style="{StaticResource TextButton}"
                    Text="Clear selected" />
            </Grid>
            <CollectionView
                Grid.Row="2"
                ItemsSource="{Binding MediaItems}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:MediaLibraryItemViewModel">
                        <Border Margin="0,0,0,10" Style="{StaticResource MediaCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDetailsCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border
                                    HeightRequest="42"
                                    WidthRequest="42"
                                    VerticalOptions="Center"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13">
                                    <Label
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Text="{Binding TypeBadge}"
                                        TextColor="{StaticResource Primary}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding FileName}"
                                        TextColor="{StaticResource Ink}" />
                                    <HorizontalStackLayout Spacing="7">
                                        <Label FontSize="12" Text="{Binding MediaType}" TextColor="{StaticResource InkMuted}" />
                                        <Label FontSize="12" Text="·" TextColor="{StaticResource InkMuted}" />
                                        <Label FontSize="12" Text="{Binding FileSize}" TextColor="{StaticResource InkMuted}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <CheckBox
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    IsChecked="{Binding IsSelected}"
                                    Color="{StaticResource Primary}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <ScrollView
            Grid.Row="1"
            ZIndex="10"
            BackgroundColor="{StaticResource Canvas}"
            IsVisible="{Binding Details.IsVisible}">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label FontAttributes="Bold" FontSize="27" Text="Media details" TextColor="{StaticResource Ink}" />
                        <Label FontSize="12" Text="Lightweight preview · No playback" TextColor="{StaticResource InkMuted}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Command="{Binding Details.CloseCommand}" Style="{StaticResource TextButton}" Text="Close" />
                </Grid>

                <Border Style="{StaticResource DetailsCard}">
                    <VerticalStackLayout Spacing="16">
                        <Grid HeightRequest="210">
                            <Border
                                BackgroundColor="{StaticResource Ink}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <Image
                                    Aspect="AspectFit"
                                    IsVisible="{Binding Details.HasPreview}"
                                    Source="{Binding Details.PreviewImage}" />
                            </Border>

                            <Border
                                IsVisible="{Binding Details.IsAudio}"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14">
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="AUDIO"
                                        TextColor="{StaticResource Primary}" />
                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                                        <BoxView HeightRequest="24" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="48" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="34" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="62" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="40" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="52" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="28" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding Details.ShowPreviewPlaceholder}"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="7">
                                    <Label FontAttributes="Bold" Text="Preview unavailable" TextColor="{StaticResource Ink}" />
                                    <Label FontSize="12" Text="Your original file is unchanged" TextColor="{StaticResource InkMuted}" />
                                </VerticalStackLayout>
                            </Border>

                            <ActivityIndicator
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsRunning="{Binding Details.IsLoading}"
                                IsVisible="{Binding Details.IsLoading}"
                                Color="{StaticResource Primary}" />
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="19"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding Details.FileName}"
                                TextColor="{StaticResource Ink}" />
                            <Label FontSize="13" Text="{Binding Details.MediaType}" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="FILE SIZE" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.FileSize}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" IsVisible="{Binding Details.HasDuration}" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="DURATION" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.Duration}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" IsVisible="{Binding Details.HasDimensions}" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="DIMENSIONS" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.Dimensions}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding Details.HasCodec}" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="CODEC / FORMAT" TextColor="{StaticResource InkMuted}" />
                                    <Label
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Details.Codec}"
                                        TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label
                            FontSize="12"
                            LineHeight="1.35"
                            Text="{Binding Details.ErrorMessage}"
                            TextColor="{StaticResource InkMuted}" />

                        <Button
                            Command="{Binding Details.Export.OpenCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Text="Plan an export" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView
            Grid.Row="1"
            ZIndex="20"
            BackgroundColor="{StaticResource Canvas}"
            IsVisible="{Binding Details.Export.IsVisible}">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label FontAttributes="Bold" FontSize="27" Text="Plan your export" TextColor="{StaticResource Ink}" />
                        <Label FontSize="12" Text="Choose a creator preset · review only" TextColor="{StaticResource InkMuted}" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        Command="{Binding Details.Export.CloseCommand}"
                        Style="{StaticResource TextButton}"
                        Text="Back" />
                </Grid>

                <Border Style="{StaticResource DetailsCard}">
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" Text="EXPORT PRESET" TextColor="{StaticResource Ink}" />
                            <Picker
                                ItemDisplayBinding="{Binding Name}"
                                ItemsSource="{Binding Details.Export.CompatiblePresets}"
                                SelectedItem="{Binding Details.Export.SelectedPreset}"
                                Style="{StaticResource PresetPicker}"
                                Title="Choose a preset" />
                            <Label
                                FontSize="13"
                                LineHeight="1.35"
                                Text="{Binding Details.Export.PresetDescription}"
                                TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>

                        <Border
                            Padding="15"
                            BackgroundColor="{StaticResource MintSoft}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="5">
                                <Label FontAttributes="Bold" FontSize="12" Text="SAFE OUTPUT NAME" TextColor="{StaticResource MintDark}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    LineBreakMode="MiddleTruncation"
                                    MaxLines="1"
                                    Text="{Binding Details.Export.OutputFileName}"
                                    TextColor="{StaticResource Ink}" />
                                <Label
                                    FontSize="11"
                                    Text="A new file is proposed. The original is never overwritten."
                                    TextColor="{StaticResource MintDark}" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="FORMAT" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.Export.OutputFormat}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="QUALITY" TextColor="{StaticResource InkMuted}" />
                                    <Label
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Details.Export.Quality}"
                                        TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="ASPECT RATIO" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.Export.AspectRatio}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="KEY SETTINGS" TextColor="{StaticResource InkMuted}" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Details.Export.SettingsSummary}"
                                        TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border
                            Padding="14"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Plan ready for a future sprint" TextColor="{StaticResource Primary}" />
                                <Label
                                    FontSize="12"
                                    LineHeight="1.35"
                                    Text="{Binding Details.Export.ValidationMessage}"
                                    TextColor="{StaticResource InkMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <Button
                            Command="{Binding Details.Export.QueuePlanCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Text="Add plan to queue" />
                        <Label
                            HorizontalTextAlignment="Center"
                            FontSize="11"
                            Text="Queue planning only · no file will be created."
                            TextColor="{StaticResource InkMuted}" />

                        <VerticalStackLayout IsVisible="{Binding Details.Export.HasQueuedJobs}" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label FontAttributes="Bold" FontSize="17" Text="Export queue" TextColor="{StaticResource Ink}" />
                                <Label
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    FontSize="12"
                                    Text="{Binding Details.Export.QueueCountLabel}"
                                    TextColor="{StaticResource InkMuted}" />
                            </Grid>
                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Details.Export.QueuedJobs}"
                                Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="coreModels:ConversionJob">
                                        <Border Style="{StaticResource QueueCard}">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                                <Label
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1"
                                                    Text="{Binding Plan.ProposedOutputFileName}"
                                                    TextColor="{StaticResource Ink}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="9,4"
                                                    BackgroundColor="{StaticResource PrimarySoft}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="10"
                                                        Text="{Binding State}"
                                                        TextColor="{StaticResource Primary}" />
                                                </Border>
                                                <Label
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    FontSize="11"
                                                    Text="{Binding StatusMessage}"
                                                    TextColor="{StaticResource InkMuted}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label
                                FontSize="11"
                                LineHeight="1.3"
                                Text="{Binding Details.Export.QueueMessage}"
                                TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Label
                IsVisible="{Binding HasMedia}"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Text="{Binding StatusMessage}"
                TextColor="{StaticResource InkMuted}" />
            <Button Command="{Binding ImportMediaCommand}" Style="{StaticResource PrimaryButton}" Text="Choose media" />
            <Label
                HorizontalTextAlignment="Center"
                FontSize="11"
                Text="Uses the secure system picker · No broad storage access"
                TextColor="{StaticResource InkMuted}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
