<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MediaForge.Universal.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:MediaForge.Universal.ViewModels"
    x:DataType="viewModels:HomeViewModel"
    BackgroundColor="{StaticResource Canvas}">
    <ScrollView>
        <Grid Padding="24,32,24,28" RowDefinitions="Auto,*,Auto" RowSpacing="32">
            <HorizontalStackLayout Spacing="10">
                <Border
                    Padding="10,6"
                    BackgroundColor="{StaticResource PrimarySoft}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12">
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="MF"
                        TextColor="{StaticResource Primary}" />
                </Border>
                <Label
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    FontSize="17"
                    Text="{Binding ProductName}"
                    TextColor="{StaticResource Ink}" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="24">
                <Border
                    Padding="12,7"
                    HorizontalOptions="Start"
                    BackgroundColor="{StaticResource MintSoft}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="OFFLINE BY DEFAULT"
                        TextColor="{StaticResource MintDark}" />
                </Border>

                <Label
                    FontAttributes="Bold"
                    FontSize="44"
                    LineHeight="1.05"
                    Text="{Binding Headline}"
                    TextColor="{StaticResource Ink}"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    FontSize="17"
                    LineHeight="1.5"
                    Text="{Binding Description}"
                    TextColor="{StaticResource InkMuted}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource FeatureCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label FontSize="22" Text="↯" TextColor="{StaticResource Primary}" />
                            <Label FontAttributes="Bold" Text="Fast &amp; simple" TextColor="{StaticResource Ink}" />
                            <Label FontSize="12" Text="Creator-friendly presets" TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FeatureCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label FontSize="22" Text="✓" TextColor="{StaticResource MintDark}" />
                            <Label FontAttributes="Bold" Text="Private" TextColor="{StaticResource Ink}" />
                            <Label FontSize="12" Text="Files stay on device" TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <Border
                Grid.Row="2"
                Padding="18,14"
                BackgroundColor="{StaticResource Ink}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border
                        HeightRequest="10"
                        WidthRequest="10"
                        VerticalOptions="Center"
                        BackgroundColor="{StaticResource Mint}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 5" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label FontAttributes="Bold" FontSize="14" Text="{Binding FoundationStatus}" TextColor="White" />
                        <Label FontSize="12" Text="Foundation ready for future conversion workflows" TextColor="#C7C4D4" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
