<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MediaForge.Universal.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:MediaForge.Universal.ViewModels"
    x:DataType="viewModels:HomeViewModel"
    BackgroundColor="{StaticResource Canvas}">
    <Grid Padding="24,28,24,24" RowDefinitions="Auto,*,Auto" RowSpacing="20">
        <Grid ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Spacing="10">
                <Border
                    Padding="10,6"
                    BackgroundColor="{StaticResource PrimarySoft}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12">
                    <Label FontAttributes="Bold" FontSize="13" Text="MF" TextColor="{StaticResource Primary}" />
                </Border>
                <Label
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    FontSize="17"
                    Text="{Binding ProductName}"
                    TextColor="{StaticResource Ink}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                <Button
                    Command="{Binding Details.Export.OpenQueueCommand}"
                    Style="{StaticResource TextButton}"
                    Text="{Binding Details.Export.QueueCountLabel}" />
                <ActivityIndicator
                    IsRunning="{Binding Details.Export.IsBusy}"
                    IsVisible="{Binding Details.Export.IsBusy}"
                    Color="{StaticResource Primary}" />
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource Primary}" />
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" IsVisible="{Binding ShowWelcome}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="22">
                <Border
                    Padding="12,7"
                    HorizontalOptions="Start"
                    BackgroundColor="{StaticResource MintSoft}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                    <Label FontAttributes="Bold" FontSize="12" Text="OFFLINE BY DEFAULT" TextColor="{StaticResource MintDark}" />
                </Border>
                <Label
                    FontAttributes="Bold"
                    FontSize="42"
                    LineHeight="1.05"
                    Text="{Binding Headline}"
                    TextColor="{StaticResource Ink}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label FontSize="16" LineHeight="1.45" Text="{Binding Description}" TextColor="{StaticResource InkMuted}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource FeatureCard}">
                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" Text="Fast &amp; simple" TextColor="{StaticResource Ink}" />
                            <Label FontSize="12" Text="Pick multiple media files" TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource FeatureCard}">
                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" Text="Private" TextColor="{StaticResource Ink}" />
                            <Label FontSize="12" Text="Files stay on device" TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Label
                    IsVisible="{Binding IsStatusVisible}"
                    FontSize="13"
                    Text="{Binding StatusMessage}"
                    TextColor="{StaticResource InkMuted}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            Grid.Row="1"
            IsVisible="{Binding HasMedia}"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label FontAttributes="Bold" FontSize="28" Text="Media library" TextColor="{StaticResource Ink}" />
                    <Label FontSize="13" Text="{Binding ImportedCountLabel}" TextColor="{StaticResource InkMuted}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Command="{Binding ClearAllCommand}" Style="{StaticResource TextButton}" Text="Clear all" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <Label
                    VerticalOptions="Center"
                    FontSize="12"
                    Text="Tap a card to preview, or choose Convert"
                    TextColor="{StaticResource InkMuted}" />
                <Button
                    Grid.Column="1"
                    Command="{Binding ConvertSelectedCommand}"
                    IsVisible="{Binding HasSelection}"
                    Style="{StaticResource TextButton}"
                    Text="Convert selected" />
                <Button
                    Grid.Column="2"
                    Command="{Binding ClearSelectedCommand}"
                    IsVisible="{Binding HasSelection}"
                    Style="{StaticResource TextButton}"
                    Text="Clear selected" />
            </Grid>
            <CollectionView
                Grid.Row="2"
                ItemsSource="{Binding MediaItems}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:MediaLibraryItemViewModel">
                        <Border Margin="0,0,0,10" Style="{StaticResource MediaCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDetailsCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Border
                                    HeightRequest="42"
                                    WidthRequest="42"
                                    VerticalOptions="Center"
                                    BackgroundColor="{StaticResource PrimarySoft}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13">
                                    <Label
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Text="{Binding TypeBadge}"
                                        TextColor="{StaticResource Primary}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding FileName}"
                                        TextColor="{StaticResource Ink}" />
                                    <HorizontalStackLayout Spacing="7">
                                        <Label FontSize="12" Text="{Binding MediaType}" TextColor="{StaticResource InkMuted}" />
                                        <Label FontSize="12" Text="·" TextColor="{StaticResource InkMuted}" />
                                        <Label FontSize="12" Text="{Binding FileSize}" TextColor="{StaticResource InkMuted}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <CheckBox
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    IsChecked="{Binding IsSelected}"
                                    Color="{StaticResource Primary}" />
                                <Button
                                    Grid.Column="3"
                                    Command="{Binding ConvertCommand}"
                                    SemanticProperties.Description="Open conversion options for this media file"
                                    Style="{StaticResource TextButton}"
                                    Text="Convert →" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <ScrollView
            Grid.Row="1"
            ZIndex="10"
            BackgroundColor="{StaticResource Canvas}"
            IsVisible="{Binding Details.IsVisible}">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label FontAttributes="Bold" FontSize="27" Text="Media details" TextColor="{StaticResource Ink}" />
                        <Label FontSize="12" Text="Lightweight preview · No playback" TextColor="{StaticResource InkMuted}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Command="{Binding Details.CloseCommand}" Style="{StaticResource TextButton}" Text="Close" />
                </Grid>

                <Border Style="{StaticResource DetailsCard}">
                    <VerticalStackLayout Spacing="16">
                        <Grid HeightRequest="210">
                            <Border
                                BackgroundColor="{StaticResource Ink}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <Image
                                    Aspect="AspectFit"
                                    IsVisible="{Binding Details.HasPreview}"
                                    Source="{Binding Details.PreviewImage}" />
                            </Border>

                            <Border
                                IsVisible="{Binding Details.IsAudio}"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14">
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="AUDIO"
                                        TextColor="{StaticResource Primary}" />
                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                                        <BoxView HeightRequest="24" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="48" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="34" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="62" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="40" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="52" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                        <BoxView HeightRequest="28" WidthRequest="5" CornerRadius="3" Color="{StaticResource Primary}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                IsVisible="{Binding Details.ShowPreviewPlaceholder}"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="7">
                                    <Label FontAttributes="Bold" Text="Preview unavailable" TextColor="{StaticResource Ink}" />
                                    <Label FontSize="12" Text="Your original file is unchanged" TextColor="{StaticResource InkMuted}" />
                                </VerticalStackLayout>
                            </Border>

                            <ActivityIndicator
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsRunning="{Binding Details.IsLoading}"
                                IsVisible="{Binding Details.IsLoading}"
                                Color="{StaticResource Primary}" />
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="19"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Text="{Binding Details.FileName}"
                                TextColor="{StaticResource Ink}" />
                            <Label FontSize="13" Text="{Binding Details.MediaType}" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="FILE SIZE" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.FileSize}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" IsVisible="{Binding Details.HasDuration}" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="DURATION" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.Duration}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" IsVisible="{Binding Details.HasDimensions}" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="DIMENSIONS" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.Dimensions}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding Details.HasCodec}" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="CODEC / FORMAT" TextColor="{StaticResource InkMuted}" />
                                    <Label
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Details.Codec}"
                                        TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label
                            FontSize="12"
                            LineHeight="1.35"
                            Text="{Binding Details.ErrorMessage}"
                            TextColor="{StaticResource InkMuted}" />

                        <Button
                            Command="{Binding Details.Export.OpenCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Text="Plan an export" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView
            Grid.Row="1"
            ZIndex="20"
            BackgroundColor="{StaticResource Canvas}"
            IsVisible="{Binding Details.Export.IsVisible}">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label FontAttributes="Bold" FontSize="27" Text="Export plans" TextColor="{StaticResource Ink}" />
                        <Label FontSize="12" Text="Choose a creator preset · review only" TextColor="{StaticResource InkMuted}" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        Command="{Binding Details.Export.CloseCommand}"
                        Style="{StaticResource TextButton}"
                        Text="Back" />
                </Grid>

                <Border Style="{StaticResource DetailsCard}">
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout
                            IsVisible="{Binding Details.Export.IsPlanEditorVisible}"
                            Spacing="7">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Button Command="{Binding Details.Export.PreviousSourceCommand}" Style="{StaticResource TextButton}" Text="Previous" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label HorizontalTextAlignment="Center" FontAttributes="Bold" Text="{Binding Details.Export.CurrentSourceName}" TextColor="{StaticResource Ink}" />
                                    <Label HorizontalTextAlignment="Center" FontSize="11" Text="{Binding Details.Export.SourcePositionLabel}" TextColor="{StaticResource InkMuted}" />
                                    <Label
                                        IsVisible="{Binding Details.Export.HasMultipleSources}"
                                        HorizontalTextAlignment="Center"
                                        FontSize="10"
                                        Text="{Binding Details.Export.DraftProgressLabel}"
                                        TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Command="{Binding Details.Export.NextSourceCommand}" Style="{StaticResource TextButton}" Text="Next" />
                            </Grid>
                            <Label FontAttributes="Bold" FontSize="13" Text="EXPORT PRESET" TextColor="{StaticResource Ink}" />
                            <Picker
                                ItemDisplayBinding="{Binding Name}"
                                ItemsSource="{Binding Details.Export.CompatiblePresets}"
                                SelectedItem="{Binding Details.Export.SelectedPreset}"
                                Style="{StaticResource PresetPicker}"
                                Title="Choose a preset" />
                            <Label
                                FontSize="13"
                                LineHeight="1.35"
                                Text="{Binding Details.Export.PresetDescription}"
                                TextColor="{StaticResource InkMuted}" />
                            <Label FontAttributes="Bold" FontSize="12" Text="OUTPUT FORMAT" TextColor="{StaticResource Ink}" />
                            <Picker
                                ItemDisplayBinding="{Binding Label}"
                                ItemsSource="{Binding Details.Export.OutputFormats}"
                                SelectedItem="{Binding Details.Export.SelectedOutputFormat}"
                                Style="{StaticResource PresetPicker}" />
                            <Label FontAttributes="Bold" FontSize="12" Text="QUALITY" TextColor="{StaticResource Ink}" />
                            <Picker
                                ItemDisplayBinding="{Binding Label}"
                                ItemsSource="{Binding Details.Export.QualityOptions}"
                                SelectedItem="{Binding Details.Export.SelectedQuality}"
                                Style="{StaticResource PresetPicker}" />
                            <Label FontAttributes="Bold" FontSize="12" Text="ASPECT RATIO" TextColor="{StaticResource Ink}" />
                            <Picker
                                ItemDisplayBinding="{Binding Label}"
                                ItemsSource="{Binding Details.Export.AspectRatios}"
                                SelectedItem="{Binding Details.Export.SelectedAspectRatio}"
                                Style="{StaticResource PresetPicker}" />
                            <Border
                                IsVisible="{Binding Details.Export.HasMultipleSources}"
                                Padding="12"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="Use these settings for compatible files"
                                            TextColor="{StaticResource Ink}" />
                                        <Label
                                            FontSize="10"
                                            Text="When on, dropdown changes are copied automatically."
                                            TextColor="{StaticResource InkMuted}" />
                                    </VerticalStackLayout>
                                    <Switch
                                        Grid.Column="1"
                                        IsToggled="{Binding Details.Export.ApplySettingsToCompatibleFiles}"
                                        OnColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Border
                            Padding="15"
                            IsVisible="{Binding Details.Export.IsPlanEditorVisible}"
                            BackgroundColor="{StaticResource MintSoft}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="5">
                                <Label FontAttributes="Bold" FontSize="12" Text="SAFE OUTPUT NAME" TextColor="{StaticResource MintDark}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    LineBreakMode="MiddleTruncation"
                                    MaxLines="1"
                                    Text="{Binding Details.Export.OutputFileName}"
                                    TextColor="{StaticResource Ink}" />
                                <Label
                                    FontSize="11"
                                    Text="A new file is proposed. The original is never overwritten."
                                    TextColor="{StaticResource MintDark}" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid
                            IsVisible="{Binding Details.Export.IsPlanEditorVisible}"
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="10">
                            <Border Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="FORMAT" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.Export.OutputFormat}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="QUALITY" TextColor="{StaticResource InkMuted}" />
                                    <Label
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding Details.Export.Quality}"
                                        TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="ASPECT RATIO" TextColor="{StaticResource InkMuted}" />
                                    <Label FontAttributes="Bold" Text="{Binding Details.Export.AspectRatio}" TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetadataCell}">
                                <VerticalStackLayout Spacing="3">
                                    <Label FontSize="11" Text="KEY SETTINGS" TextColor="{StaticResource InkMuted}" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Details.Export.SettingsSummary}"
                                        TextColor="{StaticResource Ink}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border
                            Padding="14"
                            IsVisible="{Binding Details.Export.IsPlanEditorVisible}"
                            BackgroundColor="{StaticResource PrimarySoft}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15">
                            <VerticalStackLayout Spacing="4">
                                <Label FontAttributes="Bold" Text="Plan ready for a future sprint" TextColor="{StaticResource Primary}" />
                                <Label
                                    FontSize="12"
                                    LineHeight="1.35"
                                    Text="{Binding Details.Export.ValidationMessage}"
                                    TextColor="{StaticResource InkMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <Button
                            Command="{Binding Details.Export.QueuePlanCommand}"
                            IsVisible="{Binding Details.Export.IsPlanEditorVisible}"
                            Style="{StaticResource PrimaryButton}"
                            Text="{Binding Details.Export.QueueActionLabel}" />
                        <Label
                            IsVisible="{Binding Details.Export.IsPlanEditorVisible}"
                            HorizontalTextAlignment="Center"
                            FontSize="11"
                            Text="Queue planning only · no file will be created."
                            TextColor="{StaticResource InkMuted}" />

                        <VerticalStackLayout
                            IsVisible="{Binding Details.Export.IsQueueSectionVisible}"
                            Spacing="10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <VerticalStackLayout Spacing="1">
                                    <Label FontAttributes="Bold" FontSize="17" Text="Export queue" TextColor="{StaticResource Ink}" />
                                    <Label
                                        FontSize="12"
                                        Text="{Binding Details.Export.QueueCountLabel}"
                                        TextColor="{StaticResource InkMuted}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding Details.Export.CancelEditCommand}"
                                    IsVisible="{Binding Details.Export.IsPlanEditorVisible}"
                                    Style="{StaticResource TextButton}"
                                    Text="Done editing" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding Details.Export.ClearQueueCommand}"
                                    IsVisible="{Binding Details.Export.HasQueuedJobs}"
                                    Style="{StaticResource TextButton}"
                                    Text="Clear all" />
                            </Grid>

                            <Border
                                IsVisible="{Binding Details.Export.HasQueuedJobs}"
                                Padding="12"
                                BackgroundColor="{StaticResource MintSoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontAttributes="Bold" FontSize="12" Text="Plans are ready" TextColor="{StaticResource Ink}" />
                                        <Label
                                            FontSize="10"
                                            LineHeight="1.25"
                                            Text="{Binding Details.Export.ProcessingGuidance}"
                                            TextColor="{StaticResource InkMuted}" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding Details.Export.CloseCommand}"
                                        Style="{StaticResource TextButton}"
                                        Text="Back to library" />
                                </Grid>
                            </Border>

                            <Border
                                IsVisible="{Binding Details.Export.IsQueueEmpty}"
                                Padding="20"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontAttributes="Bold"
                                        Text="No export jobs yet"
                                        TextColor="{StaticResource Ink}" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontSize="12"
                                        Text="Choose media, review a preset, then save the plan here."
                                        TextColor="{StaticResource InkMuted}" />
                                </VerticalStackLayout>
                            </Border>

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Details.Export.QueuedJobs}"
                                IsVisible="{Binding Details.Export.HasQueuedJobs}"
                                Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:QueuedExportViewModel">
                                        <Border Padding="12" Style="{StaticResource QueueCard}">
                                            <VerticalStackLayout Spacing="5">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                    <Border
                                                        Padding="8,4"
                                                        BackgroundColor="{StaticResource PrimarySoft}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10">
                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontSize="10"
                                                            Text="{Binding PositionLabel}"
                                                            TextColor="{StaticResource Primary}" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                        <Label
                                                            FontAttributes="Bold"
                                                            LineBreakMode="TailTruncation"
                                                            MaxLines="1"
                                                            Text="{Binding OutputFileName}"
                                                            TextColor="{StaticResource Ink}" />
                                                        <Label
                                                            FontSize="11"
                                                            LineBreakMode="TailTruncation"
                                                            MaxLines="1"
                                                            Text="{Binding SourceFileName}"
                                                            TextColor="{StaticResource InkMuted}" />
                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontSize="12"
                                                            Text="{Binding ConversionRouteLabel}"
                                                            TextColor="{StaticResource Primary}" />
                                                        <Label
                                                            FontSize="10"
                                                            Text="{Binding SettingsLabel}"
                                                            TextColor="{StaticResource InkMuted}" />
                                                    </VerticalStackLayout>
                                                    <Label
                                                        Grid.Column="2"
                                                        VerticalOptions="Center"
                                                        FontAttributes="Bold"
                                                        FontSize="10"
                                                        Text="{Binding PresetName}"
                                                        TextColor="{StaticResource Primary}" />
                                                </Grid>
                                                <Label
                                                    IsVisible="{Binding HasSourceIssue}"
                                                    FontSize="11"
                                                    Text="{Binding StatusMessage}"
                                                    TextColor="{StaticResource InkMuted}" />
                                                <Label
                                                    FontSize="10"
                                                    Text="{Binding CompatibilityLabel}"
                                                    TextColor="{StaticResource InkMuted}" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <ProgressBar
                                                        Progress="{Binding Progress}"
                                                        IsVisible="{Binding ShowProgress}"
                                                        ProgressColor="{StaticResource Primary}"
                                                        VerticalOptions="Center" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="8,3"
                                                        BackgroundColor="{StaticResource PrimarySoft}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10">
                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontSize="10"
                                                            Text="{Binding StateLabel}"
                                                            TextColor="{StaticResource Primary}" />
                                                    </Border>
                                                </Grid>
                                                <Grid
                                                    IsVisible="{Binding ShowRunAction}"
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="6">
                                                    <Button
                                                        Command="{Binding RunCommand}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Text="Convert WAV → M4A" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Command="{Binding CancelCommand}"
                                                        Style="{StaticResource TextButton}"
                                                        Text="Cancel" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
                                                    <Button Command="{Binding MoveUpCommand}" Style="{StaticResource TextButton}" Text="Up" />
                                                    <Button Grid.Column="1" Command="{Binding MoveDownCommand}" Style="{StaticResource TextButton}" Text="Down" />
                                                    <Button Grid.Column="2" Command="{Binding EditCommand}" Style="{StaticResource TextButton}" Text="Edit" />
                                                    <Button Grid.Column="3" Command="{Binding RemoveCommand}" Style="{StaticResource TextButton}" Text="Remove" />
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label
                                FontSize="11"
                                LineHeight="1.3"
                                Text="{Binding Details.Export.QueueMessage}"
                                TextColor="{StaticResource InkMuted}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout
            Grid.Row="2"
            IsVisible="{Binding ShowImportActions}"
            Spacing="10">
            <Label
                IsVisible="{Binding HasMedia}"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Text="{Binding StatusMessage}"
                TextColor="{StaticResource InkMuted}" />
            <Button Command="{Binding ImportMediaCommand}" Style="{StaticResource PrimaryButton}" Text="Choose media" />
            <Label
                HorizontalTextAlignment="Center"
                FontSize="11"
                Text="Uses the secure system picker · No broad storage access"
                TextColor="{StaticResource InkMuted}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
